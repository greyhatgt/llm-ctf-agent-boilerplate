+// Function to escape shell metacharacters
+char* shell_escape(const char* str) {
+    static char escaped[512];
+    size_t i = 0, j = 0;
+
+    // Add opening quote
+    escaped[j++] = '\'';
+
+    // Copy string, escaping single quotes
+    while (str[i] && j < sizeof(escaped) - 4) {  // Leave room for closing quote
+        if (str[i] == '\'') {
+            // Close quote, insert escaped quote, reopen quote
+            escaped[j++] = '\'';
+            escaped[j++] = '\\';
+            escaped[j++] = '\'';
+            escaped[j++] = '\'';
+        } else {
+            escaped[j++] = str[i];
+        }
+        i++;
+    }
+
+    // Add closing quote
+    escaped[j++] = '\'';
+    escaped[j] = '\0';
+
+    return escaped;
+}
